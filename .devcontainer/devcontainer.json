{
  "name": "Crossplane ContribFest SLC",
  "image": "mcr.microsoft.com/devcontainers/go:2-1.26-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "redhat.vscode-yaml"]
    },
    "codespaces": {
      "openFiles": ["README.md", "labs/01-scaffold.md"]
    }
  }
}
